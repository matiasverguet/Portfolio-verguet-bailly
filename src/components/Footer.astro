const year = new Date().getFullYear();
---

<footer class="bg-footer">
  <div class="mx-auto max-w-[1440px] px-[10%] pt-[clamp(2.5rem,5.5vw,5rem)] pb-[clamp(1.5rem,3.5vw,3rem)]">
  <div class="flex flex-wrap items-end gap-x-[clamp(3rem,13vw,12rem)] gap-y-6 border-b border-ink/60 pb-[min(1vw,14.4px)]">
    <div>
      <p class="font-display text-[clamp(1rem,1.9vw,1.7rem)] font-light uppercase">Email:</p>
      <a href="mailto:matiasverguet@gmail.com" class="text-[clamp(0.85rem,1.75vw,1.55rem)] font-bold hover:text-electric">
        matiasverguet@gmail.com
      </a>
    </div>
    <div>
      <p class="font-display text-[clamp(1rem,1.9vw,1.7rem)] font-light uppercase">Tel:</p>
      <a href="tel:+33783941205" class="text-[clamp(0.85rem,1.75vw,1.55rem)] font-bold hover:text-electric">07 83 94 12 05</a>
    </div>

    <ul class="flex gap-[min(1.2vw,17.3px)] sm:ml-auto">
      <li>
        <a href="https://www.instagram.com/" target="_blank" rel="noopener" aria-label="Instagram (nouvel onglet)" class="block hover:text-electric">
          <svg viewBox="0 0 24 24" class="size-[clamp(1.1rem,2.2vw,2rem)]" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="17.5" cy="6.5" r="1.3" fill="currentColor" />
          </svg>
        </a>
      </li>
      <li>
        <a href="https://www.linkedin.com/" target="_blank" rel="noopener" aria-label="LinkedIn (nouvel onglet)" class="block hover:text-electric">
          <svg viewBox="0 0 24 24" class="size-[clamp(1.1rem,2.2vw,2rem)]" aria-hidden="true">
            <path fill="currentColor" d="M4 9h4v12H4zM6 3a2 2 0 110 4 2 2 0 010-4zM10 9h4v1.7C14.6 9.7 15.8 9 17.5 9 20.4 9 21 10.9 21 13.5V21h-4v-6.6c0-1.6-.3-2.6-1.8-2.6s-1.2 1.2-1.2 2.6V21h-4z" />
          </svg>
        </a>
      </li>
    </ul>
  </div>

  <p class="mt-[min(1.5vw,21.6px)] text-[clamp(0.8rem,1.6vw,1.45rem)]">© {year} Matias Verguet--Bailly Tous droits réservés.</p>
  </div>
</footer>
