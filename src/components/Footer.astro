---
/* Pied de page : email, téléphone, réseaux sociaux (composant SocialLinks), copyright. */
import SocialLinks from "./SocialLinks.astro";
const year = new Date().getFullYear();
---

<footer class="bg-footer">
  <div class="mx-auto max-w-[1440px] px-[10%] pt-[clamp(2.5rem,5.5vw,5rem)] pb-[clamp(1.5rem,3.5vw,3rem)]">
  <div class="flex flex-wrap items-end gap-x-[clamp(3rem,13vw,12rem)] gap-y-6 border-b border-ink/60 pb-[min(1vw,14.4px)]">
    <div>
      <p class="font-display text-[clamp(1rem,1.9vw,1.7rem)] font-light uppercase">Email:</p>
      <a href="mailto:matiasverguet@gmail.com" class="text-[clamp(0.85rem,1.75vw,1.55rem)] font-bold hover:text-electric">
        matiasverguet@gmail.com
      </a>
    </div>
    <div>
      <p class="font-display text-[clamp(1rem,1.9vw,1.7rem)] font-light uppercase">Tel:</p>
      <a href="tel:+33783941205" class="text-[clamp(0.85rem,1.75vw,1.55rem)] font-bold hover:text-electric">07 83 94 12 05</a>
    </div>

    <SocialLinks class="gap-[min(1.2vw,17.3px)] sm:ml-auto" iconClass="size-[clamp(1.1rem,2.2vw,2rem)]" />
  </div>

  <p class="mt-[min(1.5vw,21.6px)] text-[clamp(0.8rem,1.6vw,1.45rem)]">© {year} Matias Verguet--Bailly Tous droits réservés.</p>
  </div>
</footer>
