---
/* Liste des icônes de réseaux sociaux (données dans data/reseaux.js).
   Réutilisée dans le footer et sur la page Contact, avec des tailles différentes :
   - class      : classes de la liste (espacement, alignement)
   - iconClass  : taille des icônes */
import { reseaux } from "../data/reseaux.js";

interface Props {
  class?: string;
  iconClass?: string;
}

const { class: className = "", iconClass = "size-6" } = Astro.props;
---

<ul class:list={["flex", className]}>
  {
    reseaux.map((reseau) => (
      <li>
        <a href={reseau.url} target="_blank" rel="noopener" aria-label={`${reseau.nom} (nouvel onglet)`} class="block hover:text-electric">
          <svg viewBox="0 0 24 24" class={iconClass} aria-hidden="true">
            {reseau.icone === "instagram" && (
              <>
                <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2.2" />
                <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2.2" />
                <circle cx="17.5" cy="6.5" r="1.3" fill="currentColor" />
              </>
            )}
            {reseau.icone === "linkedin" && (
              <path fill="currentColor" d="M4 9h4v12H4zM6 3a2 2 0 110 4 2 2 0 010-4zM10 9h4v1.7C14.6 9.7 15.8 9 17.5 9 20.4 9 21 10.9 21 13.5V21h-4v-6.6c0-1.6-.3-2.6-1.8-2.6s-1.2 1.2-1.2 2.6V21h-4z" />
            )}
            {reseau.icone === "behance" && (
              <path fill="currentColor" d="M16.969 16.927a2.561 2.561 0 0 0 1.901.677 2.501 2.501 0 0 0 1.531-.475c.362-.235.636-.584.779-.99h2.585a5.091 5.091 0 0 1-1.9 2.896 5.292 5.292 0 0 1-3.091.88 5.839 5.839 0 0 1-2.284-.433 4.871 4.871 0 0 1-1.723-1.211 5.657 5.657 0 0 1-1.08-1.874 7.057 7.057 0 0 1-.383-2.393c-.005-.8.129-1.595.396-2.349a5.313 5.313 0 0 1 5.088-3.604 4.87 4.87 0 0 1 2.376.563c.661.362 1.231.87 1.668 1.485a6.2 6.2 0 0 1 .943 2.133c.194.821.263 1.666.205 2.508h-7.699c-.063.79.184 1.574.688 2.187ZM6.947 4.084a8.065 8.065 0 0 1 1.928.198 4.29 4.29 0 0 1 1.49.638c.418.303.748.711.958 1.182.241.579.357 1.203.341 1.83a3.506 3.506 0 0 1-.506 1.961 3.726 3.726 0 0 1-1.503 1.287 3.588 3.588 0 0 1 2.027 1.437c.464.747.697 1.615.67 2.494a4.593 4.593 0 0 1-.423 2.032 3.945 3.945 0 0 1-1.163 1.413 5.114 5.114 0 0 1-1.683.807 7.135 7.135 0 0 1-1.928.259H0V4.084h6.947Zm-.235 12.9c.308.004.616-.029.916-.099a2.18 2.18 0 0 0 .766-.332c.228-.158.411-.371.534-.619.142-.317.208-.663.191-1.009a2.08 2.08 0 0 0-.642-1.715 2.618 2.618 0 0 0-1.696-.505h-3.54v4.279h3.471Zm13.635-5.967a2.13 2.13 0 0 0-1.654-.619 2.336 2.336 0 0 0-1.163.259 2.474 2.474 0 0 0-.738.62 2.359 2.359 0 0 0-.396.792c-.074.239-.12.485-.137.734h4.769a3.239 3.239 0 0 0-.679-1.785ZM6.535 10.369a2.254 2.254 0 0 0 1.423-.433c.399-.355.607-.88.56-1.413a1.916 1.916 0 0 0-.178-.891 1.298 1.298 0 0 0-.495-.533 1.851 1.851 0 0 0-.711-.274 3.966 3.966 0 0 0-.835-.073H3.241v3.617h3.294ZM21.62 5.122h-5.976v1.527h5.976V5.122Z" />
            )}
          </svg>
        </a>
      </li>
    ))
  }
</ul>
