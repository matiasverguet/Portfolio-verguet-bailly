---
/* Image d'un projet (dossier src/assets/projets/) ou du dossier public/.
   - Image importée (objet ImageMetadata) : composant <Image> d'Astro. À la construction du site,
     Astro la convertit en WebP à la bonne taille et la met dans le site final.
   - Adresse texte (SVG ou image de public/) : balise <img> simple, sans optimisation.
   - Pas d'image : emplacement en pointillés qui indique le nom du fichier manquant. */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string | null;
  alt: string;
  nom?: string; // nom attendu, affiché si l'image manque
  class?: string;
  loading?: "lazy" | "eager";
  style?: string; // ex. view-transition-name pour l'animation entre les pages
}

const { src, alt, nom = "", class: className = "", loading = "lazy", style } = Astro.props;
---

{
  src ? (
    typeof src === "object" ? (
      <Image src={src} alt={alt} loading={loading} class={className} style={style} />
    ) : (
      <img src={src} alt={alt} loading={loading} class={className} style={style} />
    )
  ) : (
    <div style={style} class:list={["grid min-h-40 place-items-center rounded-xl border-2 border-dashed border-folder-dark p-4 text-center text-sm text-folder-dark", className]}>
      Image manquante : <strong>{nom}.webp</strong>
    </div>
  )
}
