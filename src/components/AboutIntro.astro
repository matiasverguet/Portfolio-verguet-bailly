---
/* Haut de la page About : grand titre, présentation et portrait à effet de lignes.
   portrait : chemin de l'image dans public/img/ (vide = cadre en pointillés) */
const portrait: string | undefined = "/img/portrait.webp";
---

<section class="relative grid items-start gap-10 px-[9.5%] max-sm:px-[7%] pt-[min(4vw,57.6px)] max-sm:pt-12 pb-[min(15vw,216px)] sm:grid-cols-[1fr_47%]" aria-labelledby="page-title">
  <div>
    <h1 id="page-title" class="font-display text-[clamp(3rem,10.6vw,9.5rem)] leading-[0.95] font-bold uppercase">
      À propos
    </h1>
    <p class="mt-[min(6vw,86.4px)] font-display text-[clamp(1rem,2vw,1.8rem)] font-bold uppercase">
      Matias Verguet--Bailly
    </p>

    <div class="mt-[min(1vw,14.4px)] max-w-[clamp(18rem,46vw,41rem)] space-y-[1em] text-[clamp(1rem,1.3vw,1.15rem)] leading-relaxed">
      <p>
        J'ai 19 ans et je suis actuellement en deuxième année de BUT Métiers du Multimédia et de
        l'Internet (MMI). Passionné par la communication visuelle et le numérique, je me spécialise en
        design graphique et en conception UI/UX, avec pour ambition de construire une carrière créative
        mêlant esthétique et stratégie de marque.
      </p>
      <p>
        Mon cœur de métier, c'est le graphisme : identités visuelles, affiches, interfaces. J'aime
        imaginer des univers graphiques marquants et les décliner sur tous les supports. Je sais aussi
        intégrer mes maquettes en code (j'ai développé ce portfolio moi-même) : ça ne fait pas de moi un
        développeur, mais ça me permet de concevoir des maquettes réalistes et de bien travailler avec
        ceux qui les développent.
      </p>
    </div>

    <!-- Téléchargement du CV (fichier public/cv.pdf) -->
    <a
      href="/cv.pdf"
      download="CV-Matias-Verguet-Bailly.pdf"
      class="mt-[min(3vw,43.2px)] inline-flex items-center gap-[0.6em] rounded-full bg-electric px-[1.2em] py-[0.75em] text-[clamp(0.75rem,1.2vw,1.1rem)] font-bold text-white uppercase hover:bg-ink"
    >
      Télécharger mon CV
      <svg class="size-[1.1em]" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M8 2v9M4 7l4 4 4-4M2 14h12" />
      </svg>
      <span class="sr-only">(PDF)</span>
    </a>
  </div>

  <!-- self-end : le bas de la photo s'aligne sur le bas du texte.
       origin-bottom-right : le zoom (scale-110) part de ce coin, donc le bas ne bouge pas. -->
  {
    portrait ? (
      <div data-portrait class="relative hidden w-full sm:block sm:origin-bottom-right sm:scale-110 sm:self-end">
        <img src={portrait} alt="Portrait de Matias Verguet--Bailly, pouce levé, avec un effet de lignes verticales" width="1198" height="1002" class="block w-full" />
        <!-- Bandes verticales créées par le script : elles ondulent sous la souris -->
        <div data-strips class="pointer-events-none absolute inset-0 flex" aria-hidden="true"></div>
      </div>
    ) : (
      <div class="grid aspect-[5/6] w-full place-items-center rounded-xl border-2 border-dashed border-folder-dark font-display text-xl text-folder-dark uppercase" aria-hidden="true">
        Portrait
      </div>
    )
  }
</section>

<script>
  /* Portrait animé : l'image est découpée en bandes verticales (même image en fond, décalée).
     Au survol, les bandes s'écartent autour de la souris, comme une loupe qui suit le curseur.
     Rien ne bouge si le visiteur a demandé moins d'animations, ou sur écran tactile. */
  const box = document.querySelector<HTMLElement>("[data-portrait]");
  const reduit = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const souris = matchMedia("(hover: hover) and (pointer: fine)").matches;

  if (box && !reduit && souris) {
    const img = box.querySelector("img")!;
    const zone = box.querySelector<HTMLElement>("[data-strips]")!;
    const N = 48; // nombre de bandes
    const bandes: HTMLElement[] = [];

    for (let i = 0; i < N; i++) {
      const b = document.createElement("span");
      b.style.cssText = `flex:1 1 0;height:100%;
        background:url("${img.currentSrc || img.src}") no-repeat;
        background-size:${N * 100}% 100%;
        background-position:${(i / (N - 1)) * 100}% 0;
        transform-origin:center;will-change:transform;
        transition:transform .6s cubic-bezier(.2,.8,.2,1)`;
      zone.append(b);
      bandes.push(b);
    }
    img.style.opacity = "0"; // l'image reste là pour sa taille et son texte alternatif

    /* Effet « loupe » : les bandes s'écartent autour de la souris, comme des stores
       qu'on entrouvre avec les doigts, et celle du centre s'élargit un peu. */
    let x = 0, w = 0, prevu = false;
    const dessiner = () => {
      prevu = false;
      bandes.forEach((b, i) => {
        const d = (i + 0.5) - x * N;             // distance à la souris, en bandes
        const f = Math.exp(-(d * d) / 50);       // 1 sous la souris, 0 loin
        const ecart = d * w * 0.7 * f;           // poussée vers la gauche ou la droite
        b.style.transform = `translateX(${ecart}px) scaleX(${1 + f * 0.6})`;
      });
    };

    box.addEventListener("pointermove", (e) => {
      const r = box.getBoundingClientRect();
      x = (e.clientX - r.left) / r.width;
      w = r.width / N; // largeur d'une bande
      if (!prevu) { prevu = true; requestAnimationFrame(dessiner); }
    });
    box.addEventListener("pointerleave", () => bandes.forEach((b) => (b.style.transform = "")));
  }
</script>
