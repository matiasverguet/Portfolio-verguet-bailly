---
/* Rend une image de projet cliquable pour la voir en grand (lightbox).
   C'est un vrai <button> : il marche à la souris, au toucher et au clavier (Entrée / Espace).
   La fenêtre d'agrandissement (<dialog id="lightbox">) et son script sont dans pages/projets/[slug].astro.
   Une petite loupe apparaît au survol pour montrer qu'on peut agrandir. */
interface Props {
  alt: string;
}

const { alt } = Astro.props;
---

<button type="button" data-agrandir class="group/zoom relative block w-full cursor-zoom-in rounded-[inherit]" aria-label={`Agrandir l'image : ${alt}`}>
  <slot />
  <span class="pointer-events-none absolute right-3 bottom-3 grid size-9 place-items-center rounded-full bg-ink/80 text-white opacity-0 transition-opacity group-hover/zoom:opacity-100 group-focus-visible/zoom:opacity-100 max-sm:opacity-100 max-sm:size-8" aria-hidden="true">
    <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="7" cy="7" r="5" /><path d="M11 11l3.5 3.5M7 4.5v5M4.5 7h5" /></svg>
  </span>
</button>
