---
/* Carte projet en forme de dossier.
   Empilement (du fond vers l'avant) : onglet + arrière → visuel → avant du dossier.
   L'avant cache le bas du visuel : seul le haut « dépasse » du dossier.

   Mise en page : le lien et le dossier sont en flex colonne avec flex-1,
   donc les 3 cartes d'une ligne ont toujours la même hauteur
   (la grille étire chaque carte à la hauteur de la plus grande).

   Animation au survol (ou au focus clavier), en deux temps :
   1. l'avant du dossier bascule vers nous (rotateX avec perspective),
      comme un dossier qu'on entrouvre ;
   2. 80 ms plus tard (delay), le visuel sort en grossissant et en se redressant,
      avec un petit rebond (courbe cubic-bezier qui dépasse 1 = effet ressort)
      et une ombre qui apparaît sous lui.
   Le délai n'existe qu'à l'entrée (group-hover:delay-80) : à la sortie, tout se referme ensemble. */
interface Props {
  num: string;
  titre: string;
  tags: string[];
  slug: string;
  image: string;
}

const { num, titre, tags, slug, image } = Astro.props;

// Mouvement doux pour le dossier, la flèche et la carte
const motion = "transition-transform duration-[450ms] ease-out";
// Mouvement « ressort » pour le visuel (léger dépassement puis retour)
const spring = "transition-[translate,scale,rotate,filter] duration-[650ms] ease-[cubic-bezier(0.22,1.3,0.36,1)]";
---

<a href={`/projets/${slug}`} class="group flex h-full flex-col pt-[clamp(2.5rem,4vw,3.6rem)]">
  <!-- Dossier. Son padding-top laisse voir une bande de l'arrière au-dessus de l'avant -->
  <div class:list={["relative flex flex-1 flex-col pt-[clamp(0.7rem,1.2vw,1.1rem)] group-hover:-translate-y-1 group-focus-visible:-translate-y-1", motion]}>
    <!-- Onglet + arrière du dossier -->
    <div class="absolute -top-[clamp(0.8rem,1.3vw,1.2rem)] left-0 h-[clamp(2rem,3vw,2.7rem)] w-[38%] rounded-t-xl bg-folder-dark"></div>
    <div class="absolute inset-0 rounded-xl rounded-tl-none bg-folder-dark shadow-[-6px_8px_3px_rgba(0,0,0,0.12)]"></div>

    <!-- Visuel : grand, mais presque entièrement caché derrière l'avant du dossier.
         Au repos, il est réduit (scale 0.85) et seul son haut dépasse un peu.
         Au survol, il remonte un peu ET grossit (scale 1.02). origin-bottom : il grandit
         depuis son bas, donc vers le haut, comme s'il sortait du dossier.
         Les PNG sont rognés au plus près : object-contain les affiche tous à la même taille,
         object-top aligne leur haut pour qu'ils dépassent tous pareil. -->
    <img
      src={image}
      alt=""
      loading="lazy"
      class:list={[
        "absolute -top-[clamp(2.5rem,4.5vw,4rem)] left-1/2 h-[clamp(10rem,19vw,17rem)] w-[90%] -translate-x-1/2 origin-bottom scale-[0.85] -rotate-2 object-contain object-top",
        "group-hover:-translate-y-[10%] group-hover:scale-[1.02] group-hover:rotate-0 group-hover:drop-shadow-[0_10px_8px_rgba(0,0,0,0.2)] group-hover:delay-80",
        "group-focus-visible:-translate-y-[10%] group-focus-visible:scale-[1.02] group-focus-visible:rotate-0 group-focus-visible:drop-shadow-[0_10px_8px_rgba(0,0,0,0.2)] group-focus-visible:delay-80",
        spring,
      ]}
    />

    <!-- Avant du dossier : il bascule vers nous en pivotant sur son bord bas -->
    <div
      class:list={[
        "relative flex flex-1 origin-bottom flex-col rounded-xl bg-folder px-[clamp(1rem,1.8vw,1.6rem)] py-[clamp(0.75rem,1.3vw,1.2rem)] shadow-[-6px_8px_3px_rgba(0,0,0,0.12)]",
        "group-hover:[transform:perspective(900px)_rotateX(-10deg)] group-focus-visible:[transform:perspective(900px)_rotateX(-10deg)]",
        motion,
      ]}
    >
      <p class="font-display text-[clamp(1.9rem,3.4vw,3rem)] leading-none">{num}</p>
      <span class="my-[clamp(0.35rem,0.6vw,0.55rem)] block h-[3px] w-[2em] bg-ink" aria-hidden="true"></span>
      <h3 class="max-w-[16em] font-display text-[clamp(1.05rem,1.85vw,1.65rem)] leading-tight font-bold uppercase">{titre}</h3>
      <ul class="mt-[clamp(0.4rem,0.7vw,0.65rem)] flex flex-wrap gap-1.5">
        {tags.map((tag) => <li class="rounded-full border border-ink px-[0.6em] py-[0.1em] text-[clamp(0.7rem,1.1vw,1rem)]">{tag}</li>)}
      </ul>
      <!-- mt-auto pousse la flèche tout en bas : elle est alignée sur les 3 cartes -->
      <span class:list={["mt-auto block pt-[clamp(0.4rem,0.8vw,0.7rem)] text-[clamp(1.15rem,1.9vw,1.7rem)] leading-none group-hover:translate-x-2", motion]} aria-hidden="true">→</span>
    </div>
  </div>
</a>
