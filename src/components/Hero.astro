---
/* Hero de l'accueil : à gauche mon nom dans un cadre de sélection façon Figma,
   entouré de dossiers qui flottent ; en bas à droite mon personnage 3D qui suit la souris.
   - Sur ordinateur, le hero fait toute la hauteur de l'écran moins le header :
     à l'arrivée sur la page, on ne voit que l'onglet du dossier noir (Compétences) en bas.
   - Tailles en vw (pourcentage de la largeur d'écran) ; clamp() fixe un minimum et un maximum.
   - Les dossiers sont placés en % du cadre : ils restent autour de lui à toutes les largeurs. */
import Folder from "./Folder.astro";
import Character from "./Character.astro";

// Les 4 poignées carrées aux coins du cadre
const handles = ["-top-1.5 -left-1.5", "-top-1.5 -right-1.5", "-bottom-1.5 -left-1.5", "-bottom-1.5 -right-1.5"];

// Taille commune des dossiers décoratifs
const size = "w-[clamp(4.5rem,11vw,12.5rem)] h-[clamp(3.3rem,8.2vw,9.3rem)]";
---

<!-- Hauteur sur ordinateur = 100svh (hauteur visible de l'écran) moins la hauteur du header
     (2 × son padding + la hauteur du logo + 1px de bordure).
     Pas de marge en bas pour le personnage : il touche le dossier noir de la section Compétences. -->
<section
  class="relative flex flex-col justify-center pt-[clamp(5rem,10vw,9rem)] sm:min-h-[calc(100svh-2*clamp(0.75rem,1.6vw,1.5rem)-clamp(1.4rem,2.6vw,2.35rem)-1px)] sm:pt-[clamp(5rem,9vw,9rem)] sm:pb-[clamp(5rem,9vw,9rem)]"
  aria-labelledby="hero-title"
>
  <!-- Bloc de gauche : w-fit = aussi large que son contenu (le nom) -->
  <div class="relative ml-[5%] w-fit">
    <!-- Dossiers autour du cadre (positions en % du cadre) -->
    <Folder class={`-top-[22%] -left-[1%] z-10 -rotate-3 ${size}`} />
    <!-- Dossier avec les logos de mes outils qui dépassent -->
    <Folder class={`-top-[23%] right-[6%] z-10 rotate-6 ${size}`} delay="-1.5s">
      <img src="/img/affinity.svg" alt="" class="absolute -top-[12%] left-[14%] w-[50%] -rotate-12" />
      <img src="/img/figma.svg" alt="" class="absolute -top-[20%] left-[62%] w-[26%] rotate-[18deg]" />
    </Folder>
    <Folder class={`top-[78%] left-[12%] z-10 hidden rotate-[10deg] sm:block ${size}`} delay="-4.5s" />

    <!-- Cadre de sélection : pointillés épais (3px) -->
    <div class="relative border-[3px] border-dotted border-electric px-[min(2.3vw,44px)] pt-[min(3.5vw,67px)] pb-[min(2.2vw,42px)]">
      {handles.map((pos) => (
        <span class:list={["absolute size-3 border-2 border-electric bg-white", pos]} aria-hidden="true" />
      ))}

      <h1 id="hero-title" class="font-heavy text-[clamp(1.4rem,5.8vw,7rem)] leading-[0.92] font-black whitespace-nowrap uppercase">
        <span class="block text-electric">Matias</span>
        <span class="block">Verguet--Bailly</span>
      </h1>
      <p class="font-serif text-[clamp(1.1rem,2.7vw,3.25rem)] leading-tight">Designer graphique</p>

      <!-- Curseur bleu posé sur la poignée bas-droite du cadre.
           top-full / left-full : le coin haut-gauche du SVG est placé sur le coin du cadre.
           La pointe de la flèche est à (14, 14) dans un SVG de 40 × 40, soit 35 % :
           on recule donc le SVG de 35 % pour que la pointe tombe pile sur la poignée. -->
      <svg class="absolute top-full left-full z-20 w-[clamp(1.75rem,5vw,5.5rem)] -translate-x-[35%] -translate-y-[35%] text-electric" viewBox="0 0 40 40" aria-hidden="true">
        <path d="M14 14l22 9-9 3-3 10z" fill="currentColor" />
        <path d="M8 6l3 4M4 12l4 1M13 3l1 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </div>

    <!-- Pastille de disponibilité : point bleu qui « pulse » (animate-ping = un halo qui grandit
         et disparaît en boucle, coupé si l'utilisateur a demandé à réduire les animations) -->
    <p class="mt-[min(2.5vw,36px)] flex justify-end pr-[4%]">
      <span class="inline-flex items-center gap-[0.6em] rounded-full border border-ink/15 bg-white px-[0.9em] py-[0.4em] font-display text-[clamp(0.9rem,1.7vw,2rem)] leading-tight shadow-[0_2px_8px_rgba(0,0,0,0.08)]">
        <span class="relative flex size-[0.55em] shrink-0" aria-hidden="true">
          <span class="absolute inset-0 animate-ping rounded-full bg-electric opacity-60"></span>
          <span class="relative size-full rounded-full bg-electric"></span>
        </span>
        <span><strong class="font-bold">Disponible pour un stage</strong> · du 29 mars au 4 juin 2026</span>
      </span>
    </p>
  </div>

  <!-- Personnage 3D qui suit la souris (composant Character, vidéo pilotée par la souris).
       Sur ordinateur : en position absolue, collé en bas à droite ; sa hauteur suit celle de l'écran
       (70 % de la hauteur visible), sans dépasser 38 % de la largeur (pour ne pas toucher le nom) ni 48rem.
       Son sweat noir se fond dans le dossier noir juste en dessous.
       -bottom-[6px] : il passe de 6px sous le dossier (affiché par-dessus), pour qu'aucune
       ligne claire n'apparaisse à la jonction (arrondis au pixel, bord adouci par la compression). -->
  <Character class="mx-auto mt-10 w-[70%] sm:absolute sm:right-[2%] sm:-bottom-[6px] sm:mt-0 sm:h-[min(70svh,38vw,48rem)] sm:w-auto" />
</section>
