---
/* Section « Mes projets » de l'accueil : une carte par projet, lus dans PocketBase.
   await : le composant attend la réponse de la base avant de s'afficher (côté serveur). */
import ProjectCard from "./ProjectCard.astro";
import { getProjets } from "../lib/pocketbase.js";

// Sur l'accueil, on montre les 3 premiers projets
const projets = (await getProjets()).slice(0, 3);
---

<!-- pt : espace au-dessus, pour séparer la section du bloc « À propos » -->
<section class="pt-[min(8vw,115px)] pr-[6%] pb-[min(13vw,187.2px)] pl-[9.6%]" aria-labelledby="projects-title">
  <h2 id="projects-title" class="ml-[2%] font-display text-[clamp(2.25rem,5vw,4.5rem)] leading-none font-bold uppercase">
    Mes projets
  </h2>

  <div class="mt-[clamp(2.5rem,6vw,5.4rem)] grid gap-x-[min(4vw,57.6px)] gap-y-10 sm:grid-cols-3">
    {projets.map((projet) => <ProjectCard {...projet} />)}
  </div>

  <div class="mt-[min(4vw,57.6px)] text-right">
    <a href="/projets" class="inline-flex items-center gap-[0.6em] rounded-full bg-electric px-[1.2em] py-[0.75em] text-[clamp(0.75rem,1.4vw,1.25rem)] font-bold text-white uppercase hover:bg-ink">
      Plus de projets <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
