---
/* Layout commun à toutes les pages : <head>, header, footer.
   Chaque page lui passe son titre et sa description (props). */
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Antonio:wght@300;400;700&family=Archivo:wght@800;900&family=Inter:wght@400;600;700&family=Instrument+Serif&display=swap"
      rel="stylesheet"
    />
  </head>
  <!-- overflow-x-clip : un dossier qui dépasse sur le côté ne crée pas de barre de défilement horizontale
       (contrairement à overflow-hidden, ça ne casse pas le header sticky) -->
  <body class="overflow-x-clip font-sans antialiased">
    <!-- Lien d'évitement : les utilisateurs clavier peuvent sauter le menu -->
    <a
      href="#contenu"
      class="absolute left-4 -top-24 z-50 bg-ink px-4 py-2 text-white focus:top-4"
    >
      Aller au contenu
    </a>

    <Header />

    <main id="contenu">
      <slot />
    </main>

    <Footer />
  </body>
</html>
