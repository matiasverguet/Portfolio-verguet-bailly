---
/* Layout commun à toutes les pages : <head>, header, footer.
   Chaque page lui passe son titre et sa description (props). */

// Polices hébergées sur le site (paquets Fontsource) au lieu de Google Fonts :
// le navigateur du visiteur ne contacte pas les serveurs de Google (pas de transfert d'IP, RGPD)
// et on ne charge que l'alphabet latin et les graisses utilisées (plus léger).
import "@fontsource/antonio/latin-300.css";
import "@fontsource/antonio/latin-400.css";
import "@fontsource/antonio/latin-700.css";
import "@fontsource/archivo/latin-800.css";
import "@fontsource/archivo/latin-900.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import "@fontsource/instrument-serif/latin-400.css";

import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  image?: string; // image de partage (Open Graph), par défaut /og-image.jpg
  imageAlt?: string; // description de cette image
}

const { title, description, image = "/og-image.jpg", imageAlt = "Matias Verguet--Bailly, designer graphique" } = Astro.props;

// Adresses absolues (obligatoires pour l'Open Graph et l'adresse canonique).
// Astro.site vient de « site » dans astro.config.mjs.
const canonique = new URL(Astro.url.pathname, Astro.site);
const imagePartage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Matias Verguet--Bailly" />

    <!-- Adresse officielle de la page : évite le contenu en double pour les moteurs de recherche -->
    <link rel="canonical" href={canonique} />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Icônes de l'onglet (SVG pour les navigateurs récents, PNG en secours, icône iPhone) -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#e3e3e3" />

    <!-- Open Graph : aperçu (titre, texte, image) quand le lien est partagé sur LinkedIn, Messenger… -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Matias Verguet--Bailly — Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={imagePartage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Sens de la transition entre deux pages (animations dans global.css) :
         on compare l'ancienne et la nouvelle adresse pour savoir si on ouvre un projet,
         si on en revient, ou si on passe au projet suivant.
         Script inline dans le <head> : il doit être prêt avant que la nouvelle page s'affiche
         (événement pagereveal). Navigateurs sans support : il ne fait rien.
         Seule la carte du projet ouvert (ou quitté) garde son view-transition-name : sinon toutes
         les autres cartes de la liste resteraient figées par-dessus la nouvelle page pendant l'animation. -->
    <script is:inline>
      // slug du projet dans une adresse (/projets/la-cimade → "la-cimade"), sinon null
      const slugDe = (url) => new URL(url).pathname.match(/^\/projets\/([^/]+)/)?.[1] ?? null;
      const garderSeulement = (slug) =>
        document.querySelectorAll('[style*="view-transition-name: projet-"]').forEach((el) => {
          if (!slug || !el.style.viewTransitionName.endsWith("-" + slug)) el.style.viewTransitionName = "none";
        });

      // Ancienne page, juste avant de partir :
      // - liste → projet : on ne garde que la carte du projet qu'on ouvre ;
      // - projet → liste : on garde le visuel et le titre du projet qu'on quitte ;
      // - projet → projet suivant : rien ne vole (slug différent), les pages glissent.
      addEventListener("pageswap", (e) => {
        if (!e.viewTransition || !e.activation?.entry?.url) return;
        const ici = slugDe(location.href);
        const destination = slugDe(e.activation.entry.url);
        garderSeulement(ici && destination ? null : destination ?? ici);
      });

      // Nouvelle page, juste avant de s'afficher
      addEventListener("pagereveal", (e) => {
        const depart = window.navigation?.activation?.from?.url;
        if (!e.viewTransition || !depart) return;
        const avant = slugDe(depart);
        const apres = slugDe(navigation.activation.entry.url);
        const sens = avant && apres ? "projet-suivant" : apres ? "vers-projet" : avant ? "depuis-projet" : null;
        if (sens) e.viewTransition.types.add(sens);
        // Retour à la liste : seule la carte du projet qu'on vient de quitter reçoit le visuel
        if (sens === "depuis-projet") garderSeulement(avant);
      });
    </script>
  </head>
  <!-- overflow-x-clip : un dossier qui dépasse sur le côté ne crée pas de barre de défilement horizontale
       (contrairement à overflow-hidden, ça ne casse pas le header sticky) -->
  <body class="overflow-x-clip font-sans antialiased">
    <!-- Lien d'évitement : les utilisateurs clavier peuvent sauter le menu -->
    <a
      href="#contenu"
      class="absolute left-4 -top-24 z-50 bg-ink px-4 py-2 text-white focus:top-4"
    >
      Aller au contenu
    </a>

    <Header />

    <main id="contenu">
      <slot />
    </main>

    <Footer />
  </body>
</html>
