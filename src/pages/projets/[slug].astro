---
/* Page d'un projet : /projets/chorus-symphonia, /projets/la-cimade…
   Le [slug] entre crochets dans le nom du fichier = une page par valeur.
   getStaticPaths() dit à Astro quelles pages créer : une par projet de PocketBase. */
import Layout from "../../layouts/Layout.astro";
import PbImage from "../../components/PbImage.astro";
import ProjectSection from "../../components/ProjectSection.astro";
import { getProjets } from "../../lib/pocketbase.js";

export async function getStaticPaths() {
  const projets = await getProjets();
  return projets.map((projet) => ({ params: { slug: projet.slug } }));
}

// On relit les projets ici plutôt que de passer par getStaticPaths :
// en développement, Astro garde getStaticPaths en mémoire, alors que ce code
// est réexécuté à chaque chargement → une modification dans PocketBase apparaît tout de suite.
const projets = await getProjets();
const index = projets.findIndex((p) => p.slug === Astro.params.slug);
const projet = projets[index];
// Projet suivant (on revient au premier après le dernier)
const suivant = projets[(index + 1) % projets.length];

// Les 4 rubriques de l'en-tête (on n'affiche que celles qui sont remplies)
const rubriques = [
  { titre: "Contexte", texte: projet.contexte },
  { titre: "Objectif", texte: projet.objectif },
  { titre: "Mon rôle", texte: projet.role },
  { titre: "Outils", texte: projet.outils },
].filter((r) => r.texte);

// On prépare l'affichage des sections :
// - numérotation 1, 2, 3… pour les sections qui ont un titre (sauf les listes) ;
// - deux sections "moitie" à la suite sont regroupées pour être côte à côte.
let numero = 0;
const lignes: { moitie: boolean; sections: { section: any; numero: number | null }[] }[] = [];
for (const section of projet.sections) {
  const numerotee = section.titre && section.mise_en_page !== "liste";
  const item = { section, numero: numerotee ? ++numero : null };
  const derniere = lignes.at(-1);
  if (section.mise_en_page === "moitie" && derniere?.moitie && derniere.sections.length < 2) {
    derniere.sections.push(item);
  } else {
    lignes.push({ moitie: section.mise_en_page === "moitie", sections: [item] });
  }
}
---

<!-- image : aperçu de partage propre au projet (généré par pages/og/[slug].png.ts) -->
<Layout
  title={`${projet.titre} — Matias Verguet--Bailly`}
  description={`${projet.titre} : ${projet.sous_titre}. ${projet.contexte}`}
  image={`/og/${projet.slug}.png`}
  imageAlt={`${projet.titre} : visuel du projet sortant d'un dossier bleu`}
>
  <article class="mx-auto max-w-[1440px] px-[8%] pt-[min(4vw,57px)] max-sm:pt-10 pb-[min(10vw,144px)]">
    <!-- Pastille de retour : zone cliquable d'au moins 44px de haut (min-h-11) -->
    <a href="/projets" class="inline-flex min-h-11 items-center gap-2 rounded-full border border-ink px-4 text-[clamp(0.9rem,1vw,0.95rem)] font-semibold transition-colors hover:bg-ink hover:text-white">
      <span aria-hidden="true">←</span> Tous les projets
    </a>

    <!-- ===== En-tête : texte à gauche, catégorie + image à droite ===== -->
    <header class="mt-[min(2.5vw,36px)] grid gap-10 sm:grid-cols-[1fr_1fr] sm:gap-[min(5vw,72px)]">
      <div>
        <!-- view-transition-name : même nom que sur la carte projet → animation entre les deux pages -->
        <h1 style={`view-transition-name: projet-titre-${projet.slug}`} class="font-display text-[clamp(2.5rem,4.6vw,4.2rem)] leading-none font-bold uppercase">{projet.titre}</h1>
        <p class="mt-[0.3em] text-[clamp(1rem,1.25vw,1.15rem)] font-bold">{projet.sous_titre}</p>

        <dl class="mt-titre space-y-[min(2vw,28px)]">
          {
            rubriques.map((r) => (
              <div>
                <dt class="font-display text-[clamp(1.4rem,2.3vw,2.1rem)] leading-tight uppercase">{r.titre}</dt>
                <dd class="mt-[0.15em] text-[clamp(1rem,1.2vw,1.1rem)] leading-snug">{r.texte}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="flex flex-col gap-6">
        <p class="flex items-center justify-start gap-3 text-[clamp(1.1rem,1.8vw,1.6rem)] font-bold uppercase sm:justify-end">
          [{projet.categorie}]
          {projet.logo_outil && <img src={`/img/${projet.logo_outil}.svg`} alt="" class="h-[1.3em] w-auto" />}
        </p>
        <PbImage src={projet.couverture} nom="couverture" style={`view-transition-name: projet-visuel-${projet.slug}`} alt={`${projet.titre} — visuel principal`} loading="eager" class="w-full" />
      </div>
    </header>

    <!-- ===== Sections ===== -->
    {
      lignes.map((ligne) =>
        ligne.moitie ? (
          <div class="grid gap-x-[min(5vw,72px)] sm:grid-cols-2">
            {ligne.sections.map(({ section, numero }) => <ProjectSection section={section} numero={numero} projet={projet.titre} />)}
          </div>
        ) : (
          <ProjectSection section={ligne.sections[0].section} numero={ligne.sections[0].numero} projet={projet.titre} />
        ),
      )
    }

    <!-- ===== Mention légale : projet étudiant ou personnel (étiquette « Perso »), marques de tiers ===== -->
    <p class="mt-[min(6vw,86px)] max-w-[52rem] border-l-4 border-electric pl-4 text-[clamp(0.85rem,1vw,0.95rem)] leading-snug text-ink/80">
      {projet.tags.includes("Perso")
        ? "Projet personnel, réalisé de ma propre initiative : il n'a pas été commandé par les organismes cités."
        : "Projet réalisé dans le cadre de ma formation en BUT MMI : exercice pédagogique, non commandé par les organismes cités."}{" "}
      Les noms, logos, photos et marques de tiers restent la propriété de leurs
      détenteurs. <a href="/mentions-legales#propriete" class="underline hover:text-electric">En savoir plus</a>
    </p>

    <!-- ===== Projet suivant ===== -->
    {
      suivant.slug !== projet.slug && (
        <nav class="mt-[min(8vw,115px)] flex justify-end border-t border-ink/40 pt-6" aria-label="Projet suivant">
          <a href={`/projets/${suivant.slug}`} class="group text-right hover:text-electric">
            <span class="block text-[clamp(0.8rem,1vw,0.9rem)] font-semibold uppercase">Projet suivant</span>
            <span class="font-display text-[clamp(1.8rem,3.5vw,3.2rem)] leading-none font-bold uppercase">
              {suivant.titre} <span class="inline-block transition-transform group-hover:translate-x-2" aria-hidden="true">→</span>
            </span>
          </a>
        </nav>
      )
    }
  </article>

  <!-- ===== Lightbox : image agrandie =====
       <dialog> + showModal() : le navigateur gère le fond sombre, le piège du focus et la touche Échap.
       Le script recopie l'image cliquée dedans. -->
  <dialog id="lightbox" aria-label="Image agrandie" class="m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-ink/85">
    <div class="flex h-dvh w-screen items-center justify-center p-4 sm:p-10" data-lightbox-fond>
      <img data-lightbox-image src="" alt="" class="max-h-[85dvh] max-w-[min(100%,1100px)] rounded-xl object-contain shadow-2xl" />
    </div>
    <button type="button" data-lightbox-fermer class="absolute top-4 right-4 grid size-11 place-items-center rounded-full bg-white text-ink hover:bg-electric hover:text-white" aria-label="Fermer l'image">
      <svg class="size-5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" /></svg>
    </button>
  </dialog>
</Layout>

<script>
  /* Lightbox : clic sur une image de projet → on l'affiche en grand dans le <dialog>.
     On ferme avec la croix, Échap (géré par le navigateur) ou un clic à côté de l'image. */
  const lightbox = document.querySelector<HTMLDialogElement>("#lightbox");
  const grande = lightbox?.querySelector<HTMLImageElement>("[data-lightbox-image]");

  document.querySelectorAll<HTMLButtonElement>("[data-agrandir]").forEach((bouton) => {
    bouton.addEventListener("click", () => {
      const image = bouton.querySelector("img");
      if (!lightbox || !grande || !image) return;
      grande.src = image.currentSrc || image.src;
      grande.alt = image.alt;
      // Image transparente (logo, PNG détouré…) : on reprend la couleur de sa carte (blanc, bleu nuit…),
      // sinon elle flotterait seule sur le fond sombre. Pas de carte : pas de fond.
      let carte: HTMLElement | null = bouton.parentElement;
      let couleur = "";
      while (carte && !carte.matches("section, main")) {
        const fond = getComputedStyle(carte).backgroundColor;
        if (fond && fond !== "transparent" && !fond.endsWith(", 0)")) {
          couleur = fond;
          break;
        }
        carte = carte.parentElement;
      }
      grande.style.backgroundColor = couleur;
      grande.style.padding = couleur ? "clamp(1rem, 4vw, 3rem)" : "";
      lightbox.showModal();
    });
  });

  lightbox?.querySelector("[data-lightbox-fermer]")?.addEventListener("click", () => lightbox.close());
  // Clic sur le fond (pas sur l'image) : on ferme
  lightbox?.querySelector("[data-lightbox-fond]")?.addEventListener("click", (e) => {
    if (e.target === e.currentTarget) lightbox.close();
  });
  // On vide l'image à la fermeture (évite de revoir l'ancienne une fraction de seconde)
  lightbox?.addEventListener("close", () => grande?.removeAttribute("src"));
</script>
