---
/* Page 404 : affichée quand l'adresse demandée n'existe pas.
   Astro génère 404.html ; les hébergeurs l'affichent automatiquement pour les pages introuvables. */
import Layout from "../layouts/Layout.astro";
import Folder from "../components/Folder.astro";

const liens = [
  { href: "/", label: "Accueil" },
  { href: "/projets", label: "Mes projets" },
  { href: "/contact", label: "Contact" },
];
---

<Layout title="Page introuvable — Matias Verguet--Bailly" description="Cette page n'existe pas ou a été déplacée.">
  <section class="relative mx-auto flex min-h-[70svh] max-w-[1440px] flex-col items-center justify-center px-[6%] py-20 text-center" aria-labelledby="titre-404">
    <!-- Un dossier vide qui flotte : le fichier demandé n'est pas dedans -->
    <div class="relative h-[clamp(6rem,14vw,11rem)] w-[clamp(8rem,19vw,15rem)]">
      <Folder class="inset-0 -rotate-6" />
    </div>

    <h1 id="titre-404" class="mt-8 font-display text-[clamp(4rem,14vw,11rem)] leading-none font-bold">404</h1>
    <p class="mt-2 font-display text-[clamp(1.25rem,2.5vw,2.2rem)] uppercase">Ce dossier est vide</p>
    <p class="mt-3 max-w-[34rem] text-[clamp(0.95rem,1.2vw,1.1rem)]">
      La page que vous cherchez n'existe pas ou a été déplacée. Voici où vous pouvez aller :
    </p>

    <ul class="mt-8 flex flex-wrap justify-center gap-3">
      {
        liens.map((lien, i) => (
          <li>
            <a
              href={lien.href}
              class:list={[
                "inline-flex items-center gap-[0.6em] rounded-full px-[1.2em] py-[0.7em] text-sm font-bold uppercase",
                i === 0 ? "bg-electric text-white hover:bg-ink" : "border-2 border-ink hover:bg-ink hover:text-white",
              ]}
            >
              {lien.label} {i === 0 && <span aria-hidden="true">→</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
