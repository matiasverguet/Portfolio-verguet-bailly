---
/* Page Contact : coordonnées à gauche, formulaire à droite.
   Le formulaire envoie le message dans la collection « messages » de PocketBase
   (script en bas de page) ; je le lis ensuite dans l'interface de PocketBase. */
import Layout from "../layouts/Layout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import Pastille from "../components/Pastille.astro";
import { PB_URL } from "../lib/pocketbase.js";

// Types de demande (boutons radio en forme d'étiquettes).
// valeur = ce qui est enregistré dans PocketBase (doit correspondre aux choix du champ « sujet »)
const sujets = [
  { label: "Stage/Alternance", valeur: "Stage/Alternance" },
  { label: "Identité visuelle", valeur: "Identité visuelle" },
  { label: "Autre ?", valeur: "Autre" },
];

// Classes communes : carte blanche, titres, libellés, valeurs, champs
const carte = "rounded-2xl bg-white px-[clamp(1.25rem,2vw,1.8rem)] pt-[clamp(1.25rem,2vw,1.8rem)] pb-[clamp(1.5rem,2.5vw,2.25rem)] shadow-[-6px_8px_18px_rgba(0,0,0,0.1)]";
const titre = "font-display text-[clamp(2rem,4.3vw,3.9rem)] leading-none uppercase";
const libelle = "block font-display text-[clamp(1.1rem,2.1vw,1.9rem)] leading-tight uppercase";
const valeur = "font-display text-[clamp(1rem,1.9vw,1.7rem)] leading-tight";
const champ = "mt-[0.4em] w-full rounded-xl border border-ink bg-white px-[0.8em] py-[0.7em] text-[clamp(0.95rem,1.2vw,1.1rem)]";
---

<Layout
  title="Contact — Matias Verguet--Bailly"
  description="Contactez Matias Verguet--Bailly, designer graphique disponible pour un stage du 29 mars au 4 juin 2027, à Belfort, Montbéliard et alentours."
>
  <div class="mx-auto max-w-[1440px] px-[6%] pt-[min(5vw,72px)] max-sm:pt-12 pb-[min(8vw,115px)]">
    <h1 class="text-center font-display text-[clamp(2.5rem,9vw,8.1rem)] leading-none font-bold uppercase">
      Discutons d'un projet
    </h1>

    <div class="mx-auto mt-[min(5vw,72px)] grid max-w-[min(80vw,1150px)] gap-[min(3.7vw,53px)] max-sm:max-w-none sm:grid-cols-2">
      <!-- ===== Coordonnées ===== -->
      <section class={carte} aria-labelledby="coord-title">
        <h2 id="coord-title" class={titre}>Coordonnées</h2>

        <!-- Liste de définitions : chaque info = un terme (dt) + sa valeur (dd) -->
        <dl class="mt-titre mr-[6%]">
          <div class="border-b border-ink/70 pb-[0.6em]">
            <dt class={libelle}>Statut</dt>
            <!-- Même pastille que dans le hero et le menu mobile -->
            <dd class="mt-[0.5em]"><Pastille class="text-[clamp(0.95rem,1.4vw,1.25rem)]" /></dd>
          </div>
          <div class="border-b border-ink/70 py-[0.6em]">
            <dt class={libelle}>Email</dt>
            <dd class={valeur}><a href="mailto:matiasverguet@gmail.com" class="break-all hover:text-electric">matiasverguet@gmail.com</a></dd>
          </div>
          <div class="border-b border-ink/70 py-[0.6em]">
            <dt class={libelle}>Tél.</dt>
            <dd class={valeur}><a href="tel:+33783941205" class="hover:text-electric">07 83 94 12 05</a></dd>
          </div>
          <div class="border-b border-ink/70 py-[0.6em]">
            <dt class={libelle}>Localisation</dt>
            <dd class={valeur}>Belfort, Montbéliard et les alentours</dd>
          </div>
        </dl>

        <SocialLinks class="mt-[min(2vw,29px)] justify-center gap-[min(5vw,72px)]" iconClass="size-[clamp(2.25rem,4vw,3.6rem)]" />
      </section>

      <!-- ===== Formulaire ===== -->
      <section class={carte} aria-labelledby="form-title">
        <h2 id="form-title" class:list={[titre, "mt-[0.3em]"]}>Contactez-moi</h2>

        <!-- required + type="email" : le navigateur vérifie lui-même les champs avant l'envoi -->
        <!-- data-pb : adresse de PocketBase, transmise au script depuis la partie serveur -->
        <form data-contact data-pb={PB_URL} class="mt-titre flex flex-col gap-[min(1.4vw,20px)]">
          <label class={libelle}>
            Votre nom
            <input type="text" name="nom" autocomplete="name" required minlength="2" maxlength="100" class={champ} />
          </label>

          <label class={libelle}>
            Votre email
            <input type="email" name="email" autocomplete="email" required class={champ} />
          </label>

          <!-- Sujet : vrais boutons radio (accessibles), cachés visuellement (sr-only),
               le <label> qui les entoure sert d'étiquette ; has-checked:bg-electric
               le colore en bleu quand son bouton radio est coché. -->
          <fieldset>
            <legend class="sr-only">Sujet de votre message</legend>
            <div class="flex flex-wrap gap-[0.5em]">
              {
                sujets.map((sujet, index) => (
                  <label class="cursor-pointer rounded-full border border-ink px-[0.7em] py-[0.3em] font-display text-[clamp(0.85rem,1.4vw,1.25rem)] uppercase transition-colors hover:bg-paper has-checked:bg-electric has-checked:text-white has-focus-visible:outline-3 has-focus-visible:outline-electric">
                    <input type="radio" name="sujet" value={sujet.valeur} checked={index === 0} class="sr-only" />
                    {sujet.label}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <label class={libelle}>
            Votre message
            <textarea name="message" rows="4" required minlength="10" maxlength="5000" class:list={[champ, "resize-y"]}></textarea>
          </label>

          <!-- Piège à robots (« honeypot ») : champ invisible pour les humains.
               Un robot qui remplit tous les champs le remplira aussi → le message est ignoré. -->
          <div class="hidden" aria-hidden="true">
            <label>Ne pas remplir <input type="text" name="site_web" tabindex="-1" autocomplete="off" /></label>
          </div>

          <!-- Information RGPD au moment de la collecte -->
          <!-- {" "} : espace forcé entre la phrase et le lien (Astro supprime le retour à la ligne) -->
          <p class="text-[clamp(0.85rem,0.95vw,0.9rem)] leading-snug text-ink/75">
            Vos informations servent uniquement à vous répondre et sont conservées 12 mois au maximum.{" "}
            <a href="/mentions-legales#donnees" class="underline hover:text-electric">Données personnelles</a>
          </p>

          <button
            type="submit"
            class="flex items-center justify-center gap-[0.6em] rounded-full bg-electric py-[0.45em] font-display text-[clamp(1rem,1.4vw,1.25rem)] text-white uppercase hover:bg-ink disabled:cursor-wait disabled:opacity-60"
          >
            Envoyer le message <span aria-hidden="true">→</span>
          </button>

          <!-- Message de confirmation ou d'erreur, annoncé par les lecteurs d'écran (aria-live) -->
          <p data-statut aria-live="polite" class="text-[clamp(0.85rem,1.1vw,1rem)] font-semibold empty:hidden"></p>
        </form>
      </section>
    </div>
  </div>
</Layout>

<script>
  /* Envoi du formulaire dans PocketBase avec fetch (sans recharger la page).
     PocketBase reçoit un POST sur /api/collections/messages/records et vérifie lui-même
     les champs (obligatoires, email valide, longueurs) avant d'enregistrer. */
  const form = document.querySelector<HTMLFormElement>("[data-contact]");
  const statut = document.querySelector<HTMLElement>("[data-statut]");
  const bouton = form?.querySelector<HTMLButtonElement>("button[type=submit]");

  function afficher(texte: string, erreur = false) {
    if (!statut) return;
    statut.textContent = texte;
    statut.classList.toggle("text-red-700", erreur);
    statut.classList.toggle("text-electric", !erreur);
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault(); // on gère l'envoi nous-mêmes, sans quitter la page
    const donnees = new FormData(form);

    // Piège à robots rempli : on fait semblant que tout s'est bien passé, sans rien envoyer
    if (donnees.get("site_web")) {
      form.reset();
      afficher("Merci, votre message a bien été envoyé !");
      return;
    }

    if (bouton) bouton.disabled = true; // évite les doubles envois
    afficher("Envoi en cours…");

    try {
      const reponse = await fetch(`${form.dataset.pb}/api/collections/messages/records`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          nom: donnees.get("nom"),
          email: donnees.get("email"),
          sujet: donnees.get("sujet"),
          message: donnees.get("message"),
        }),
      });

      if (reponse.status === 429) throw new Error("trop de messages"); // limite anti-spam atteinte
      if (!reponse.ok) throw new Error(`réponse ${reponse.status}`);

      form.reset();
      afficher("Merci, votre message a bien été envoyé ! Je vous réponds au plus vite.");
    } catch (erreur) {
      console.error("[Contact] envoi impossible :", erreur);
      afficher("Le message n'a pas pu être envoyé. Écrivez-moi directement à matiasverguet@gmail.com.", true);
    } finally {
      if (bouton) bouton.disabled = false;
    }
  });
</script>
