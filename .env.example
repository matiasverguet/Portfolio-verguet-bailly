# Exemple de variables d'environnement (copier en ".env" pour les utiliser en local).
# Sans .env, le site utilise le PocketBase de mon PC : http://127.0.0.1:8090

# Adresse du PocketBase en ligne (VPS de l'IUT). Sur le VPS, ce fichier est copié en .env
# dans /var/www/portfolio avant de construire le site.
PB_URL=https://api.verguet-bailly.fr
